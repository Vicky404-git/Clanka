# =========================
# Python Cache & Compiled Files
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# =========================
# Build & Distribution Artifacts
# =========================
build/
dist/
*.egg-info/
clanka.egg-info/
eggs/
.eggs/

# =========================
# Environments & uv
# =========================
.venv/
.env
# Note: uv.lock is tracked by default for reproducible environments.
# If you want to force users to generate their own lockfile, uncomment the line below.
# uv.lock

# =========================
# Clanka Specific
# =========================
# Local vector DB + memory files - regenerate with `clanka index`,
# never commit (contains embeddings of local project + chat history).
memory/
*.db
*.db-journal
*.bak

# Future memory-consolidation staging files (atomic swap pattern)
new*.md

# Ignore the local Modelfile to prevent overwriting user configs.
# Make sure Modelfile.example remains tracked.
Modelfile

# =========================
# OS & Editor Files
# =========================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# =========================
# Test / scratch scripts
# =========================
script.py
script_fixed.py

# Scoped JSON ignore - only local generated config, not all JSON in repo
/config.local.json
